{
  "python.defaultInterpreterPath": "${workspaceFolder}/server-py/venv/Scripts/python.exe",
  "python.envFile": "${workspaceFolder}/server-py/.env",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/server-py",
    "${workspaceFolder}/server-py/venv/Lib/site-packages"
  ],
  "python.autoComplete.extraPaths": [
    "${workspaceFolder}/server-py",
